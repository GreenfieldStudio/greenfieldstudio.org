# Generated, never committed on main — tools/deploy.mjs ships them to the gh-pages branch.
# The game build (node tools/sync-game.mjs):
/play/
# Full-resolution press originals and the press-kit archive (node tools/make-media.mjs):
/press/files/
/press/*.zip
# Tool scratch:
/.deploy/
# CI: a checkout of the live gh-pages branch that deploy.mjs --base reads (see .github/workflows/videos.yml)
/.live/
/.audit/
node_modules/

# Secrets, keys and local config: never commit. Also never use `git add -A` here; add files by name.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*secret*
*token*
*credentials*
*.local.json
*.local.mjs
.claude/settings.local.json
.claude/worktrees/
# Scratch: session drafts and patch files carry the author's e-mail address in their headers
/drafts/
*.patch
*.log
